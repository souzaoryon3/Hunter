FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libatomic1 && rm -rf /var/lib/apt/lists/*
COPY requirements*.txt ./
RUN pip install --no-cache-dir -r requirements-dev.txt && python -m playwright install --with-deps chromium
# Lista explicita: testes entram, arquivos privados nunca entram.
COPY backend/ backend/
COPY config/ config/
COPY messaging/ messaging/
COPY catalog_expansion/ catalog_expansion/
COPY data_mining/ data_mining/
COPY nlp/ nlp/
COPY scraping/ scraping/
COPY ops/ ops/
COPY scripts/ scripts/
COPY migrations/ migrations/
COPY frontend/ frontend/
COPY app.py auth.py serve_frontend.py pyproject.toml ./
# tests/ e docs/ entram por contexto adicional restrito, nao pelo contexto normal.
COPY --from=test_sources . /app/tests/
CMD ["python", "-B", "scripts/run_team_tests.py"]
