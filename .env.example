# Modelo informativo: NAO contem credenciais operacionais.
# Caminho recomendado para equipe: python scripts/dev.py configure
# Esse comando gera .env.dev.local com segredos novos e portas abaixo.
DEV_DB_PASSWORD=REPLACE_WITH_RANDOM_HEX_64
DEV_RABBIT_PASSWORD=REPLACE_WITH_RANDOM_HEX_64
DEV_JWT_SECRET=REPLACE_WITH_RANDOM_HEX_64
DEV_HTTP_PORT=8088
DEV_MANAGEMENT_PORT=15688

# Execucao nativa opcional: exporte variaveis no shell; a API nao carrega .env.
# Use seu PostgreSQL/RabbitMQ de desenvolvimento, nunca o banco de outro operador.
HUNTER_ENV=local
DATABASE_URL=postgresql://hunter_dev:REPLACE_URLENCODED_PASSWORD@127.0.0.1:55434/hunter_dev
MIGRATION_DATABASE_URL=postgresql://hunter_dev:REPLACE_URLENCODED_PASSWORD@127.0.0.1:55434/hunter_dev
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
RABBITMQ_URL=amqp://hunter_dev:REPLACE_URLENCODED_PASSWORD@127.0.0.1:5688/hunter_dev
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_COMMAND_TIMEOUT=30
HUNTER_COLLECTION_ENABLED=0
HUNTER_SCAN_SECONDS=2
# Producao: papeis separados, TLS verify-full/CA, AMQPS, HTTPS e cofre externo.
# Nao use os placeholders nem exponha esse ambiente de desenvolvimento na rede.

# Mercado Livre oficial: preencher SOMENTE em ambiente/arquivo local ignorado.
# Este modelo nao inicia OAuth nem libera acesso a recursos restritos.
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
MERCADOLIVRE_REDIRECT_URI=
MERCADOLIVRE_ACCESS_TOKEN=
# Refresh token nao e usado automaticamente nem renovado por este coletor.
MERCADOLIVRE_REFRESH_TOKEN=
